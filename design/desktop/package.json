{
  "name": "bambuhui-md3",
  "productName": "BambuHui MD3",
  "version": "0.1.0",
  "description": "Material Design 3 concept redesign of BambuHui — desktop shell.",
  "main": "main.js",
  "author": "codingmachineedge",
  "license": "MIT",
  "private": true,
  "scripts": {
    "prepare-app": "node prepare.js",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --win squirrel"
  },
  "devDependencies": {
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3",
    "electron-builder-squirrel-windows": "^24.13.3"
  },
  "build": {
    "appId": "io.github.codingmachineedge.bambuhuimd3",
    "productName": "BambuHui MD3",
    "artifactName": "BambuHuiMD3-Setup.${ext}",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "squirrel"
      ]
    },
    "squirrelWindows": {
      "iconUrl": "https://raw.githubusercontent.com/Ding-Ding-Projects/BambuHui/main/design/assets/showcase/og-social.webp",
      "artifactName": "BambuHuiMD3-Setup.${ext}"
    }
  }
}
